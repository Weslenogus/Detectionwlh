# HMAC key for session challenges and signed verdicts (>= 32 characters).
# Generate one with: openssl rand -base64 48
DETECTION_SECRET=

# Optional (defaults shown in README → Configuration)
# DETECTION_ALLOW_EPHEMERAL_KEY=1        # allow a per-process key in production (single instance only)
# NEXT_PUBLIC_ACTIVE_LIVENESS=false      # skip the head-turn 3D liveness challenge
# NEXT_PUBLIC_REQUEST_GEOLOCATION=false  # skip the GNSS position request
# IPAPI_IS_KEY=                          # ipapi.is key for VPN/proxy/datacenter flags
# IP_INTEL=off                           # disable outbound IP lookups
# TRUST_PROXY_HEADERS=false              # clients connect directly (no trusted reverse proxy)
